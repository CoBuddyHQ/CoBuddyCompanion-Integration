# ═══════════════════════════════════════════════════════════════════
# CoBuddy Companion App — Frontend Environment Configuration (.env)
# ═══════════════════════════════════════════════════════════════════

# 1. API & Backend Service Options
# - Local Dev (iOS Simulator / Web): http://localhost:4001/api/v1
# - Android Emulator: http://10.0.2.2:4001/api/v1
# - Local Network Device: http://192.168.1.X:4001/api/v1
# - Production: https://api.cobuddy.in/api/v1
API_BASE_URL="http://10.236.57.38:4001/api/v1"

# 2. Socket.IO Real-time Connection Gateway
SOCKET_URL="http://10.236.57.38:4001"

# 3. Application Environment Mode
# Values: development | staging | production
APP_ENV="development"

# 4. Third-Party Integrations
# Google Maps API Key for Live Tracking & Location Search
GOOGLE_MAPS_API_KEY="AIzaSy_YOUR_GOOGLE_MAPS_API_KEY_HERE"

# Razorpay Client Publishable Key
RAZORPAY_KEY_ID="rzp_test_YOUR_RAZORPAY_KEY_ID"

# Firebase Cloud Messaging (FCM) Configuration
FCM_SENDER_ID="1234567890"
FIREBASE_APP_ID="1:1234567890:android:abcdef"

# 5. Feature Flags & Defaults
ENABLE_LOGGING="true"
DEFAULT_LANGUAGE="en"
REQUEST_TIMEOUT_MS="15000"
